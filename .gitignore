# -- Analisa-PT Tools ----------------------------------------------------------
# Everything under data/ is generated or downloaded -- never committed
docs/analisa-pt/tools/data/
docs/analisa-pt/tools/*.db
# NIF database -- regenerate with freguesia_downloader.py
docs/analisa-pt/tools/freguesia_nif_database.json
# Vector DBs -- regenerate with bep_scraper.py collect + bep_rag.py index
docs/analisa-pt/tools/lancedb_bep/
docs/analisa-pt/tools/lancedb_law/
docs/analisa-pt/tools/chroma_bep/
# Competitor cache -- regenerate with competitor_recover.py fetch
docs/analisa-pt/tools/competitor_cache.json
docs/analisa-pt/tools/data/competitor_cache.json
# Local mapping cache (regenerated by freguesia_resolver.py)
docs/analisa-pt/tools/local_execucao_to_ine.json
# Runtime API server logs (regenerated on each run)
docs/analisa-pt/tools/api_log.txt
docs/analisa-pt/tools/api_server.log
# Stray nul file occasionally created on Windows shells
docs/analisa-pt/tools/nul
